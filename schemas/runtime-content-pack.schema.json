{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"InkDice runtime data pack v1",
  "description":"当前可导入的纯资料包协议；不是可执行插件清单。运行时另检查 ID 唯一性、文件体积和总存储限额。",
  "type":"object","additionalProperties":false,
  "required":["format","schemaVersion","id","name","version","author","entries"],
  "properties":{
    "format":{"const":"inkdice-content-pack"},"schemaVersion":{"const":1},
    "id":{"type":"string","maxLength":60,"pattern":"^[a-z0-9][a-z0-9._-]*$"},
    "name":{"type":"string","minLength":1,"maxLength":80},
    "version":{"type":"string","minLength":1,"maxLength":30},
    "author":{"type":"string","minLength":1,"maxLength":80},
    "entries":{"type":"array","minItems":1,"maxItems":2000,"items":{
      "type":"object","additionalProperties":false,"required":["id","ruleset","kind","name","payload"],
      "properties":{
        "id":{"type":"string","maxLength":80,"pattern":"^[a-zA-Z0-9._-]+$"},
        "ruleset":{"enum":["dnd5e-2014","dnd5r-2024","coc-7e"]},
        "kind":{"enum":["spell","weapon","armor","curio","item","reference"]},
        "name":{"type":"string","minLength":1,"maxLength":120},
        "rank":{"type":["integer","null"],"minimum":0,"maximum":9},
        "payload":{"type":"object","maxProperties":50,"propertyNames":{"maxLength":60,"not":{"enum":["__proto__","prototype","constructor"]}},"properties":{"职业列表":{"type":"array","maxItems":30,"items":{"type":"string","maxLength":60}}},"additionalProperties":{"type":["string","number","boolean"],"maxLength":20000}}
      },
      "allOf":[
        {"if":{"properties":{"ruleset":{"const":"coc-7e"}}},"then":{"properties":{"kind":{"enum":["weapon","armor","reference"]}}}},
        {"if":{"properties":{"kind":{"const":"spell"}}},"then":{"required":["rank"],"properties":{"rank":{"type":"integer","minimum":0,"maximum":9},"payload":{"required":["职业列表"],"properties":{"职业列表":{"minItems":1}}}}},"else":{"properties":{"rank":{"type":"null"}}}}
      ]
    }}
  }
}
